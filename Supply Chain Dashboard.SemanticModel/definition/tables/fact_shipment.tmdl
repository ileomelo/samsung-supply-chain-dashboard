		isHidden
		formatString: 0
		lineageTag: bb4e4f11-6c6a-4e7a-9031-ad8669d4a224
		summarizeBy: none
		sourceColumn: ship_date_key

		annotation SummarizationSetBy = Automatic

	/// Sequential dim_date key for recorded shipment delivery, populated for every status.
