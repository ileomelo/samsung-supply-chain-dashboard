	partition fact_inventory = m
		mode: import
		source =
				let
				  Source = Csv.Document(File.Contents(Text.TrimEnd(DatasetFolder, {"\", "/"}) & "\fact_inventory.csv"), [Delimiter = ",", Columns = 7, QuoteStyle = QuoteStyle.None]),
				  #"Promoted headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"inventory_id", Int64.Type}, {"date_key", Int64.Type}, {"product_id", Int64.Type}, {"facility_id", Int64.Type}, {"stock_level", Int64.Type}, {"safety_stock_level", Int64.Type}, {"reorder_point", Int64.Type}})
				in
				  #"Changed column type"

	annotation PBI_ResultType = Table

